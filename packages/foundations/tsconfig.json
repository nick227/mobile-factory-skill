{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": [
      "react-native"
    ],
    "lib": [
      "DOM",
      "ESNext"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/src/ui": [
        "../ui/src/index.ts"
      ],
      "@/src/foundations/*": [
        "./src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ],
      "*": [
        "./node_modules/*",
        "../../apps/lab/node_modules/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
