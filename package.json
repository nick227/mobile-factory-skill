{
  "name": "mobile-software-factory",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "lab": "pnpm --filter @factory/lab start",
    "lab:android": "pnpm --filter @factory/lab android",
    "lab:ios": "pnpm --filter @factory/lab ios",
    "check": "node scripts/check.mjs && node scripts/design-lint.mjs && pnpm exec tsc --noEmit -p apps/lab/tsconfig.json && node --test tests/*.test.mjs && corepack pnpm exec tsx --test packages/ui/tests/*.test.tsx packages/assembly/tests/*.test.tsx",
    "test:ui": "corepack pnpm exec tsx --test packages/ui/tests/*.test.tsx packages/assembly/tests/*.test.tsx",
    "component:new": "node scripts/create-component.mjs",
    "create:app": "node scripts/create-app.mjs",
    "skill:build": "node scripts/build-skill.mjs",
    "skill:verify": "node scripts/verify-skill.mjs",
    "test:governance": "node --test tests/*.test.mjs",
    "lab:scenario": "pnpm lab",
    "test:taxonomy": "node scripts/check.mjs",
    "design:lint": "node scripts/design-lint.mjs",
    "lab:typecheck": "pnpm --filter @factory/lab typecheck",
    "factory": "node scripts/factory.mjs",
    "test:factory-v1": "node --test tests/factory-v1.test.mjs",
    "interview:bench": "node bench/interview/run.mjs"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-test-renderer": "19.3.0",
    "tsx": "4.19.2",
    "typescript": "~5.9.3"
  }
}
